# Copy to backend/.env and replace all example values. Never commit real credentials.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/sovereign_expense
JWT_SECRET=replace-this-with-a-cryptographically-random-secret-over-32-bytes
PORT=5000
NODE_ENV=development
# Registration and password reset require SMTP:
SMTP_USER=
SMTP_PASS=
# PDF email delivery configuration:
SMTP_HOST=
SMTP_PORT=587
